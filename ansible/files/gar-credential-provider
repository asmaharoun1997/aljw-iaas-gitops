#!/usr/bin/env bash
# Credential provider kubelet pour Artifact Registry.
# Lit le jeton OAuth du compte de service de la VM via le serveur de métadonnées.
# Aucune clé stockée. Stdout = uniquement la réponse JSON attendue par le kubelet.
set -euo pipefail

cat >/dev/null   # le kubelet envoie une requête sur stdin, inutile ici

REGISTRY_HOST="${GAR_REGISTRY_HOST:-europe-west1-docker.pkg.dev}"

TOKEN="$(curl -sf --max-time 5 -H 'Metadata-Flavor: Google' \
  'http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token' \
  | jq -r .access_token)"

[ -n "$TOKEN" ] && [ "$TOKEN" != "null" ] || { echo "token introuvable" >&2; exit 1; }

jq -n --arg host "$REGISTRY_HOST" --arg token "$TOKEN" '{
  apiVersion: "credentialprovider.kubelet.k8s.io/v1",
  kind: "CredentialProviderResponse",
  cacheKeyType: "Registry",
  cacheDuration: "1800s",
  auth: { ($host): { username: "oauth2accesstoken", password: $token } }
}'
