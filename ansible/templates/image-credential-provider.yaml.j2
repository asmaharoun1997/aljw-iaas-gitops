apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: gar-credential-provider
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    matchImages:
      - "{{ registry_host }}"
    defaultCacheDuration: "30m"
    env:
      - name: GAR_REGISTRY_HOST
        value: "{{ registry_host }}"
